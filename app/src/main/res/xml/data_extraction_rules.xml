<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="prefs2.xml"/>
        <include domain="database" path="."/>
    </cloud-backup>
    <!-- device-to-device migration must not carry Twitch OAuth tokens (same policy as cloud backup and manual backup) -->
    <device-transfer>
        <exclude domain="sharedpref" path="prefs2.xml"/>
    </device-transfer>
</data-extraction-rules>
